# npm Configuration for Containment Protocol

# Use exact versions from lock file for reproducible installs
engine-strict=true

# Show which peer dependencies aren't satisfied
legacy-peer-deps=false

# Set appropriate registry (use default npm registry)
registry=https://registry.npmjs.org/

# Fail audits on moderate, high and critical vulnerabilities
audit-level=moderate

# Keep newly saved direct dependency specifications exact
save-exact=true

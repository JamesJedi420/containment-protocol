{
  "fixturePack": "spe-3303.instruction-resolution",
  "fixtureVersion": "1.0.0",
  "owner": "SPE-3303",
  "status": "synthetic_fixtures_only",
  "authority": {
    "attendance": "caller_supplied_authoritative_result",
    "enrollment": "not_implemented_out_of_scope",
    "progression": "reference_only_existing_agent_progression",
    "numericEffectMagnitudes": "unapproved",
    "gradingFormula": "unapproved"
  },
  "canonicalSpaces": {
    "stableId": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "source": "scripts/validation/academy-authored-content.mjs (SHARED_ID_SPACE = academy-stable-id)"
    },
    "statKey": {
      "allowed": ["combat", "investigation", "utility", "social"],
      "source": "src/domain/sim/instructorAssignment.ts (INSTRUCTOR_SPECIALTY_KEYS)"
    },
    "efficiencyBand": {
      "allowed": [0, 1, 2],
      "source": "src/domain/sim/instructorAssignment.ts (getInstructorBonus: >=90 -> 2, >=70 -> 1, else 0)",
      "note": "Band identity is grounded in existing code; the band's effect on lesson credit is unapproved."
    },
    "trainingProgram": {
      "allowed": [
        "combat-drills",
        "threat-assessment",
        "analysis-lab",
        "field-improv",
        "logistics-cycle",
        "endurance-protocol",
        "anomaly-conditioning",
        "liaison-briefing"
      ],
      "source": "src/data/training.ts (trainingCatalog trainingId values)"
    },
    "progressionRef": {
      "grammar": "moduleRef#session-<n>",
      "note": "Composed from the SPE-3304 shared stable-id space plus a session ordinal. Session-level stable IDs are NOT registered by SPE-3304 slice 1; see CONTRACT-AMBIGUITIES.md A1."
    }
  },
  "atoms": [
    {
      "atom": "E_base",
      "meaning": "credit effect of one evaluated present session under ordinary teaching",
      "approval": "unapproved_magnitude",
      "relations": ["E_base > 0"]
    },
    {
      "atom": "E_prep",
      "meaning": "additional effect attributable to caller-supplied preparation evidence",
      "approval": "unapproved_magnitude",
      "relations": ["E_prep >= 0"]
    },
    {
      "atom": "E_instructor_band_0",
      "meaning": "instructor-context effect at efficiency band 0",
      "approval": "unapproved_magnitude",
      "relations": ["E_instructor_band_0 >= 0"]
    },
    {
      "atom": "E_instructor_band_1",
      "meaning": "instructor-context effect at efficiency band 1",
      "approval": "unapproved_magnitude",
      "relations": ["E_instructor_band_1 >= E_instructor_band_0"]
    },
    {
      "atom": "E_instructor_band_2",
      "meaning": "instructor-context effect at efficiency band 2",
      "approval": "unapproved_magnitude",
      "relations": ["E_instructor_band_2 >= E_instructor_band_1"]
    },
    {
      "atom": "E_peer_assist",
      "meaning": "peer assistance effect",
      "approval": "unapproved_magnitude",
      "relations": ["E_peer_assist >= 0"]
    },
    {
      "atom": "E_peer_interfere",
      "meaning": "peer interference effect, subtracted from the session effect",
      "approval": "unapproved_magnitude",
      "relations": ["E_peer_interfere >= 0"]
    },
    {
      "atom": "E_makeup",
      "meaning": "effect of an authorized make-up session credited to the original session reference",
      "approval": "unapproved_magnitude",
      "relations": ["E_makeup >= 0", "E_makeup <= E_base"]
    }
  ],
  "classes": [
    "ordinary_teaching",
    "no_change_lesson",
    "skipped_attendance",
    "excused_attendance",
    "authorized_makeup",
    "unauthorized_makeup",
    "attendance_authority_missing",
    "preparation_effect",
    "instructor_context_effect",
    "peer_assistance",
    "peer_interference",
    "capped_progression",
    "repeated_evaluation",
    "replay"
  ],
  "dispositions": [
    "credit_granted",
    "no_progression_change",
    "credit_capped",
    "deferred",
    "not_evaluated",
    "duplicate_suppressed",
    "rejected_unauthorized_makeup"
  ],
  "attendanceStatuses": ["present", "skipped", "excused", "unknown"],
  "attendanceAuthorities": ["caller", "none"],
  "lessonEffects": ["advances", "no_change"],
  "disallowedEmissions": [
    "enrollment_record",
    "learning_state_snapshot",
    "faculty_quality_score",
    "disciplinary_case",
    "xp_or_level_change",
    "stat_cap_change",
    "game_engine_effect"
  ],
  "requiredClasses": [
    "ordinary_teaching",
    "no_change_lesson",
    "skipped_attendance",
    "excused_attendance",
    "authorized_makeup",
    "preparation_effect",
    "instructor_context_effect",
    "peer_assistance",
    "peer_interference",
    "capped_progression",
    "repeated_evaluation",
    "replay"
  ],
  "invariants": [
    {
      "id": "credit_within_capacity",
      "statement": "creditedSessionsBefore + deltaSessions <= moduleCapacity",
      "checkedAs": "arithmetic"
    },
    {
      "id": "no_double_credit",
      "statement": "a (learnerRef, sessionRef) pair may receive at most one session of credit across the pack",
      "checkedAs": "pack_grouping"
    },
    {
      "id": "no_credit_without_authoritative_presence",
      "statement": "deltaSessions is 0 whenever attendance.status is not an authoritative present result",
      "checkedAs": "cross_field"
    },
    {
      "id": "excused_differs_from_skipped",
      "statement": "excused attendance defers to a pending make-up reference; skipped attendance resolves without a progression reference",
      "checkedAs": "pack_pairing"
    },
    {
      "id": "makeup_credits_original_session",
      "statement": "an authorized make-up credits lesson.makeup.forSessionRef, not a new session ordinal",
      "checkedAs": "cross_field"
    },
    {
      "id": "authorized_makeup_requires_authority_ref",
      "statement": "an authorized make-up requires a non-empty authorizationRef",
      "checkedAs": "cross_field"
    },
    {
      "id": "unauthorized_makeup_grants_no_credit",
      "statement": "an unauthorized make-up grants no credit and no progression reference",
      "checkedAs": "cross_field"
    },
    {
      "id": "no_change_lesson_emits_no_delta",
      "statement": "a lesson authored as no_change produces no progression delta and no progression reference",
      "checkedAs": "cross_field"
    },
    {
      "id": "cap_not_exceeded",
      "statement": "no case may expect creditedSessionsAfter greater than its moduleCapacity",
      "checkedAs": "arithmetic"
    },
    {
      "id": "credited_sessions_never_negative",
      "statement": "creditedSessionsAfter and deltaSessions are never negative",
      "checkedAs": "arithmetic"
    },
    {
      "id": "idempotent_by_outcome_ref",
      "statement": "re-delivering an already-evaluated caller outcomeRef suppresses credit",
      "checkedAs": "cross_field"
    },
    {
      "id": "no_enrollment_inference",
      "statement": "resolution does not require, infer, or write an enrollment record",
      "checkedAs": "emission"
    },
    {
      "id": "attendance_authority_required",
      "statement": "without caller attendance authority the session is not evaluated",
      "checkedAs": "cross_field"
    },
    {
      "id": "no_disciplinary_output",
      "statement": "skipped attendance produces no disciplinary resolution output",
      "checkedAs": "emission"
    },
    {
      "id": "instructor_effect_nonnegative",
      "statement": "an assigned matching instructor may not reduce the session effect",
      "checkedAs": "order_property"
    },
    {
      "id": "instructor_specialty_must_match_target_stat",
      "statement": "instructor context applies only when instructorContext.specialty equals progressionState.targetStat",
      "checkedAs": "cross_field"
    },
    {
      "id": "peer_effect_sign_matches_declared_effect",
      "statement": "assistance enters the effect expression positively; interference enters negatively",
      "checkedAs": "expression"
    }
  ],
  "lessons": [
    {
      "courseRef": "course-foundations",
      "moduleRef": "module-foundations-core",

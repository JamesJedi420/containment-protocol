{
  "name": "containment-protocol-breach",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "verify-read-only-handoff": "node scripts/verify-read-only-handoff.mjs",
    "session:preflight": "node scripts/session-preflight.mjs --stdin",
    "verify:session-preflight": "node --test scripts/session-preflight.test.mjs scripts/session-preflight-review.test.mjs",
    "dev": "vite --config app.vite.config.ts --configLoader native",
    "build": "tsc -b && vite build --config app.vite.config.ts --configLoader native",
    "build:bundle": "vite build --config app.vite.config.ts --configLoader native",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview --config app.vite.config.ts --configLoader native",
    "test": "vitest --config app.vite.config.ts --configLoader native --environment jsdom --globals --pool vmThreads",
    "test:run": "vitest run --config app.vite.config.ts --configLoader native --environment jsdom --globals --pool vmThreads",
    "test:run:ci": "node scripts/test-execution-completeness/run-ci-suite.mjs",
    "test:ui": "vitest --config app.vite.config.ts --configLoader native --environment jsdom --globals --pool vmThreads --ui",
    "coverage": "vitest run --config app.vite.config.ts --configLoader native --environment jsdom --globals --pool vmThreads --coverage",
    "coverage:ci": "vitest run --config app.vite.config.ts --configLoader native --environment jsdom --globals --pool forks --coverage",
    "verify:audits-index": "node scripts/verify-design-audits-index.mjs",
    "verify:backlog-handoff": "node scripts/verify-backlog-handoff.mjs",
    "verify:theme-contracts": "node scripts/verify-external-theme-contracts.mjs",
    "verify:governance-contract": "node --test scripts/governance/authority-contract.check.mjs",
    "verify:requirements": "node scripts/validation/run-requirements.mjs",
    "verify:requirements:test": "node --test scripts/validation/requirement-model.check.mjs scripts/validation/session-preflight-selection.check.mjs scripts/validation/academy-authored-content.check.mjs",
    "verify:test-completeness": "node --test scripts/test-execution-completeness/evaluate.test.mjs scripts/test-execution-completeness/inventory.test.mjs",
    "verify:academy-authored-content": "node scripts/validation/academy-authored-content.mjs && node --test scripts/validation/academy-authored-content.check.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --reporter=list,html && npm run test:errors",
    "test:errors": "playwright test --config playwright.errors.config.ts",
    "verify:trigger-compatibility": "node --test scripts/trigger-dev-compatibility.check.mjs",
    "project:approved-work": "node scripts/project-approved-work.mjs",
    "test:approved-work": "node --test scripts/project-approved-work.test.mjs scripts/export-linear-approved-work.test.mjs",
    "export:approved-work": "node scripts/export-linear-approved-work.mjs"
  },
  "dependencies": {
    "@sentry/react": "11.11.0",
    "@trigger.dev/sdk": "^4.8.5",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@trigger.dev/build": "4.8.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.8",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "zod": "4.6.7",
    "@trigger.dev/build": {
      "@prisma/config": {
        "deepmerge-ts": "8.0.2"
      },
      "tsconfck": {
        "typescript": "$typescript"
      }
    },
    "minimatch": "11.0.5"
  }
}

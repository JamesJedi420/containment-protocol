{
  "name": "containment-protocol-breach",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config app.vite.config.ts --configLoader native",
    "build": "tsc -b && vite build --config app.vite.config.ts --configLoader native",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview --config app.vite.config.ts --configLoader native",
    "test": "vitest --config app.vite.config.ts --configLoader native --environment jsdom --globals --pool vmThreads",
    "test:run": "vitest run --config app.vite.config.ts --configLoader native --environment jsdom --globals --pool vmThreads",
    "test:run:ci": "vitest run --config app.vite.config.ts --configLoader native --environment jsdom --globals --pool forks",
    "test:ui": "vitest --config app.vite.config.ts --configLoader native --environment jsdom --globals --pool vmThreads --ui",
    "coverage": "vitest run --config app.vite.config.ts --configLoader native --environment jsdom --globals --pool vmThreads --coverage",
    "coverage:ci": "vitest run --config app.vite.config.ts --configLoader native --environment jsdom --globals --pool forks --coverage",
    "verify:audits-index": "node scripts/verify-design-audits-index.mjs",
    "verify:backlog-handoff": "node scripts/verify-backlog-handoff.mjs",
    "verify:theme-contracts": "node scripts/verify-external-theme-contracts.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.1"
  }
}
